using TorneoEsports.ViewModels.TorneoFormViewModel;
@model Torneo
@{
    ViewData["Title"] = "Eliminar torneo";
}

<h1 class="h3 mb-3">Eliminar torneo</h1>

<div class="alert alert-warning">
    ¿Seguro que deseas eliminar el torneo <strong>@Model.NombreTorneo</strong>
    (@Model.FechaInicio.ToString("dd/MM/yyyy") - @Model.FechaFin.ToString("dd/MM/yyyy"))?
    @if (Model.Partidas.Any())
    {
        <div class="mt-2">Tiene <strong>@Model.Partidas.Count</strong> partida(s): no podrá eliminarse mientras existan.</div>
    }
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="ID" />
    <button type="submit" class="btn btn-danger">Sí, eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>