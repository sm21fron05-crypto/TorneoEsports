@model Torneo
@{
    ViewData["Title"] = Model.NombreTorneo;
}

<h1 class="h3 mb-3">@Model.NombreTorneo</h1>

<dl class="row">
    <dt class="col-sm-3">Fecha de inicio</dt>
    <dd class="col-sm-9">@Model.FechaInicio.ToString("dd/MM/yyyy")</dd>

    <dt class="col-sm-3">Fecha de fin</dt>
    <dd class="col-sm-9">@Model.FechaFin.ToString("dd/MM/yyyy")</dd>
</dl>

<h2 class="h5">Equipos participantes (@Model.Equipos.Count)</h2>
@if (Model.Equipos.Any())
{
    <ul class="list-group mb-4">
        @foreach (var equipo in Model.Equipos.OrderBy(e => e.NombreEquipo))
        {
            <li class="list-group-item">
                <strong>@equipo.NombreEquipo</strong> <span class="text-muted">— @equipo.Pais</span>
            </li>
        }
    </ul>
}
else
{
    <p class="text-muted">Este torneo todavía no tiene equipos.</p>
}

<h2 class="h5">Partidas (@Model.Partidas.Count)</h2>
@if (Model.Partidas.Any())
{
    <table class="table table-striped align-middle mb-4">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Hora</th>
                <th>Enfrentamiento</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var partida in Model.Partidas.OrderBy(p => p.FechaPartida).ThenBy(p => p.Hora))
            {
                <tr>
                    <td>@partida.FechaPartida.ToString("dd/MM/yyyy")</td>
                    <td>@partida.Hora.ToString("HH:mm")</td>
                    <td>
                        @if (partida.Enfrentamientos.Any())
                        {
                            @string.Join(" vs ", partida.Enfrentamientos.Select(en =>
                                en.Equipo.NombreEquipo + (en.Resultado != null ? $" ({en.Resultado})" : "")))
                        }
                        else
                        {
                            <span class="text-muted">Sin equipos asignados</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">Este torneo todavía no tiene partidas.</p>
}

<a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.ID">Editar</a>
<a class="btn btn-secondary" asp-action="Index">Volver a la lista</a>