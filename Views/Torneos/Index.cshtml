using TorneoEsports.ViewModels.TorneoFormViewModel;
@model List<Torneo>
@{
    ViewData["Title"] = "Torneos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Torneos</h1>
    <a class="btn btn-primary" asp-action="Create">Registrar torneo</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-sm-6 col-md-4">
        <input type="text" name="buscar" value="@ViewData["Buscar"]" class="form-control" placeholder="Buscar por nombre" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
        <a asp-action="Index" class="btn btn-link">Limpiar</a>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay torneos para mostrar.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Torneo</th>
                <th>Inicio</th>
                <th>Fin</th>
                <th>Equipos</th>
                <th>Partidas</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var torneo in Model)
            {
                <tr>
                    <td>@torneo.NombreTorneo</td>
                    <td>@torneo.FechaInicio.ToString("dd/MM/yyyy")</td>
                    <td>@torneo.FechaFin.ToString("dd/MM/yyyy")</td>
                    <td>@torneo.Equipos.Count</td>
                    <td>@torneo.Partidas.Count</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@torneo.ID">Ver</a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@torneo.ID">Editar</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@torneo.ID">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <p class="text-muted">Total: @Model.Count torneo(s).</p>
}