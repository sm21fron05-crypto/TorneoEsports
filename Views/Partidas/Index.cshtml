@model IEnumerable<TorneoEsports.Models.Partida>
@{
    ViewData["Title"] = "Partidas Programadas";
}

<h2>Gestión de Partidas</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Programar Nueva Partida</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Torneo</th>
            <th>Sede</th>
            <th>Fecha</th>
            <th>Hora</th>
            <th>Equipos (Enfrentamiento)</th>
            <th>Árbitros</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Torneo?.NombreTorneo</td>
                <td>@item.Sede?.NombreSede</td>
                <td>@item.FechaPartida.ToString("dd/MM/yyyy")</td>
                <td>@item.Hora.ToString("HH:mm")</td>
                <td>@string.Join(" vs ", item.Enfrentamientos.Select(e => e.Equipo?.NombreEquipo))</td>
                <td>@string.Join(", ", item.Arbitros.Select(a => a.NombreArbitro))</td>
            </tr>
        }
    </tbody>
</table>