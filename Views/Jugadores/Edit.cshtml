@*
    VISTA: Jugadores/Edit.cshtml
    Formulario de edición de datos de un jugador.
*@
@model JugadorFormViewModel
@{
    ViewData["Title"] = "Editar jugador";
}

<h1 class="h3 mb-3">Editar jugador</h1>

<div class="row">
    <div class="col-md-6">
        @* Petición HTTP POST hacia JugadoresController.Edit(id, modelo) *@
        <form asp-action="Edit">
            @* Clave primaria oculta para el Model Binder *@
            <input type="hidden" asp-for="ID" />
            
            <partial name="_Formulario" model="Model" />
            
            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
