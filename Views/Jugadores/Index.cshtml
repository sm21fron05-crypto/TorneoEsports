@*
    VISTA: Jugadores/Index.cshtml
    Muestra el listado de jugadores con filtros combinados (búsqueda por texto y dropdown por equipo).
    Modelo: JugadorListaViewModel (transporta los resultados, el estado de los filtros y el catálogo de equipos).
*@
@model JugadorListaViewModel
@{
    ViewData["Title"] = "Jugadores";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Jugadores</h1>
    <a class="btn btn-primary" asp-action="Create">Registrar jugador</a>
</div>

@* Formulario de filtros mediante HTTP GET (los filtros viajan en la QueryString de la URL) *@
<form method="get" class="row g-2 mb-3">
    <!-- Filtro por texto: Nickname o Nombre Real -->
    <div class="col-sm-5 col-md-4">
        <input type="text" name="buscar" value="@Model.Buscar" class="form-control" placeholder="Buscar por nickname o nombre" />
    </div>

    <!-- Filtro por desplegable: Equipos -->
    <div class="col-sm-4 col-md-3">
        @* asp-items puebla automáticamente las opciones <option> desde Model.Equipos *@
        <select name="equipoId" class="form-select" asp-items="Model.Equipos">
            <option value="">Todos los equipos</option>
        </select>
    </div>

    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Filtrar</button>
        <a asp-action="Index" class="btn btn-link">Limpiar</a>
    </div>
</form>

@* Comprobación si no hay resultados *@
@if (!Model.Jugadores.Any())
{
    <div class="alert alert-info">No hay jugadores para mostrar.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Nickname</th>
                <th>Nombre real</th>
                <th>Equipo</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var jugador in Model.Jugadores)
            {
                <tr>
                    <td><strong>@jugador.Nickname</strong></td>
                    <td>@jugador.NombreReal</td>
                    @* Navegación a la entidad padre Equipo (requiere .Include(j => j.Equipo) en el controlador) *@
                    <td>@jugador.Equipo?.NombreEquipo</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@jugador.ID">Ver</a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@jugador.ID">Editar</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@jugador.ID">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    
    <p class="text-muted">Total: @Model.Jugadores.Count jugador(es).</p>
}
