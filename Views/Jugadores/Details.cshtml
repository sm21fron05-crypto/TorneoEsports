@model Jugador
@{
    ViewData["Title"] = Model.Nickname;
}

<h1 class="h3 mb-3">@Model.Nickname</h1>

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.NombreReal)</dt>
    <dd class="col-sm-9">@Model.NombreReal</dd>

    <dt class="col-sm-3">Equipo</dt>
    <dd class="col-sm-9">
        <a asp-controller="Equipos" asp-action="Details" asp-route-id="@Model.EquipoID">
            @Model.Equipo?.NombreEquipo
        </a>
    </dd>
</dl>

<a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.ID">Editar</a>
<a class="btn btn-secondary" asp-action="Index">Volver a la lista</a>
