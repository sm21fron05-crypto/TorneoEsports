@*
    VISTA: Jugadores/Create.cshtml
    Formulario de registro de un nuevo jugador en un equipo.
*@
@model JugadorFormViewModel
@{
    ViewData["Title"] = "Registrar jugador";
}

<h1 class="h3 mb-3">Registrar jugador</h1>

<div class="row">
    <div class="col-md-6">
        @* Petición HTTP POST hacia JugadoresController.Create(modelo) *@
        <form asp-action="Create">
            <partial name="_Formulario" model="Model" />
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@* Activa validaciones del lado del cliente antes de enviar el formulario *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
