@*
    VISTA PARCIAL: _Formulario.cshtml (Jugadores)
    Formulario reutilizable para Crear y Editar jugador.
    Modelo: JugadorFormViewModel
*@
@model JugadorFormViewModel

@* Resumen de validaciones a nivel general *@
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<!-- Campo: Nickname -->
<div class="mb-3">
    <label asp-for="Nickname" class="form-label"></label>
    <input asp-for="Nickname" class="form-control" />
    <span asp-validation-for="Nickname" class="text-danger"></span>
</div>

<!-- Campo: Nombre Real -->
<div class="mb-3">
    <label asp-for="NombreReal" class="form-label"></label>
    <input asp-for="NombreReal" class="form-control" />
    <span asp-validation-for="NombreReal" class="text-danger"></span>
</div>

<!-- Campo: Selección de Equipo (Dropdown / Select) -->
<div class="mb-3">
    <label asp-for="EquipoID" class="form-label"></label>
    @*
        asp-for="EquipoID": enlaza el valor seleccionado con la propiedad EquipoID del ViewModel.
        asp-items="Model.Equipos": llena los <option> con los SelectListItem generados en el controlador.
    *@
    <select asp-for="EquipoID" asp-items="Model.Equipos" class="form-select">
        <option value="">-- Selecciona un equipo --</option>
    </select>
    <span asp-validation-for="EquipoID" class="text-danger"></span>
</div>
