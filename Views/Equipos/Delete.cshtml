@model Equipo
@{
    ViewData["Title"] = "Eliminar equipo";
}

<h1 class="h3 mb-3">Eliminar equipo</h1>

<div class="alert alert-warning">
    ¿Seguro que deseas eliminar el equipo <strong>@Model.NombreEquipo</strong> (@Model.Pais)?
    
    @if (Model.Jugadores.Any())
    {
        <div class="mt-2 text-danger fw-bold">
            Tiene <strong>@Model.Jugadores.Count</strong> jugador(es) registrado(s): el sistema bloqueará la eliminación para proteger la integridad referencial.
        </div>
    }
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="ID" />
    <button type="submit" class="btn btn-danger">Sí, eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
