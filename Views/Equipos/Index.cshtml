@*
    VISTA: Equipos/Index.cshtml
    Muestra la lista de equipos, barra de búsqueda por nombre o país, y contador de jugadores.
    Modelo: IEnumerable<Equipo> (colección de equipos enviada desde EquiposController.Index)
*@
@model IEnumerable<Equipo>
@{
    ViewData["Title"] = "Equipos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Equipos</h1>
    @* Tag Helper: Redirige a la acción Create del mismo controlador *@
    <a class="btn btn-primary" asp-action="Create">Registrar equipo</a>
</div>

@* Formulario de búsqueda vía método GET (los filtros viajan en la QueryString de la URL) *@
<form method="get" class="row g-2 mb-3">
    <div class="col-sm-6 col-md-4">
        @* Mantiene el valor buscado leyendo de ViewData["Buscar"] *@
        <input type="text" name="buscar" value="@ViewData["Buscar"]" class="form-control" placeholder="Buscar por nombre o país" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
        <a asp-action="Index" class="btn btn-link">Limpiar</a>
    </div>
</form>

@* Comprobación si la colección está vacía *@
@if (!Model.Any())
{
    <div class="alert alert-info">No hay equipos para mostrar.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                @* Html.DisplayNameFor obtiene el texto definido en [Display(Name="...")] del modelo *@
                <th>@Html.DisplayNameFor(m => m.NombreEquipo)</th>
                <th>@Html.DisplayNameFor(m => m.Pais)</th>
                <th class="text-center">Jugadores</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var equipo in Model)
            {
                <tr>
                    <td>@equipo.NombreEquipo</td>
                    <td>@equipo.Pais</td>
                    @* Cuenta obtenida gracias a .Include(e => e.Jugadores) en el controlador *@
                    <td class="text-center">
                        <span class="badge bg-secondary">@equipo.Jugadores.Count</span>
                    </td>
                    <td class="text-end">
                        @* asp-route-id añade el ID a la ruta generada (ej: /Equipos/Details/5) *@
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@equipo.ID">Ver</a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@equipo.ID">Editar</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@equipo.ID">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
