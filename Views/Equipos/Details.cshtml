@model Equipo
@{
    ViewData["Title"] = Model.NombreEquipo;
}

<h1 class="h3 mb-3">@Model.NombreEquipo</h1>

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Pais)</dt>
    <dd class="col-sm-9">@Model.Pais</dd>

    <dt class="col-sm-3">Torneos en los que participa</dt>
    <dd class="col-sm-9">
        @if (Model.Torneos.Any())
        {
            @string.Join(", ", Model.Torneos.Select(t => t.NombreTorneo))
        }
        else
        {
            <span class="text-muted">Aún no participa en ningún torneo.</span>
        }
    </dd>
</dl>

<h2 class="h5">Jugadores (@Model.Jugadores.Count)</h2>
@if (Model.Jugadores.Any())
{
    <ul class="list-group mb-3">
        @foreach (var jugador in Model.Jugadores.OrderBy(j => j.Nickname))
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <strong>@jugador.Nickname</strong> <span class="text-muted">— @jugador.NombreReal</span>
                </div>
            </li>
        }
    </ul>
}
else
{
    <p class="text-muted">Este equipo todavía no tiene jugadores.</p>
}

<a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.ID">Editar</a>
<a class="btn btn-secondary" asp-action="Index">Volver a la lista</a>
